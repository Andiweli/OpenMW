<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

        <uses-feature android:name="android.hardware.gamepad" android:required="false" />

<application
        android:appCategory="game"
        android:name="utils.MyApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/MyTheme"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name="ui.activity.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="ui.activity.GameActivity"
            android:configChanges="keyboardHidden|orientation"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.AppCompat.FullScreen" />

        <activity
            android:name="ui.activity.ConfigureControls"
            android:configChanges="keyboardHidden|orientation"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.AppCompat.FullScreen" />

        <activity
            android:name="ui.activity.ModsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/activity_mods"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.Game_Mechanics_SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/game_mechanics_activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.Visuals_SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/visuals_activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.Animations_SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/animations_activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.Interface_SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/interface_activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.Bug_Fixes_SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/bug_fixes_activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.Miscellaneous_SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/miscellaneous_activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

        <activity
            android:name="ui.activity.Engine_SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/engine_activity_settings"
            android:screenOrientation="fullUser"
            android:theme="@style/MyTheme" />

    </application>
</manifest>
