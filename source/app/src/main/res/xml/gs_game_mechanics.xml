    </PreferenceCategory>
    <PreferenceCategory android:title="@string/l10n_gs_game_mechanics_gameplay_fixes_title">
        <CheckBoxPreference android:key="gs_racial_variation_in_speed_fix" android:title="@string/gs_racial_variation_in_speed_fix_title" android:summary="@string/gs_racial_variation_in_speed_fix_summary" />
        <CheckBoxPreference android:key="gs_enchanted_weapons_are_magical" android:title="@string/gs_enchanted_weapons_are_magical_title" android:defaultValue="true" android:summary="@string/gs_enchanted_weapons_are_magical_summary" />
