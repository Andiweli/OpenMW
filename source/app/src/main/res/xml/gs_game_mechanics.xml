    </PreferenceCategory>
    <PreferenceCategory android:title="@string/l10n_gs_game_mechanics_npc_followers_title">
        <CheckBoxPreference android:key="gs_followers_defend_immediately" android:title="@string/gs_followers_defend_immediately_title" android:summary="@string/gs_followers_defend_immediately_summary" />
