<?xml version='1.0' encoding='utf-8'?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/l10n_gs_game_mechanics_general_title">
        <CheckBoxPreference android:key="gs_soulgem_values_rebalance" android:title="@string/gs_soulgem_values_rebalance_title" android:summary="@string/gs_soulgem_values_rebalance_summary" />
        <CheckBoxPreference android:key="gs_can_loot_during_death_animation" android:title="@string/gs_can_loot_during_death_animation_title" android:defaultValue="true" android:summary="@string/gs_can_loot_during_death_animation_summary" />
        <CheckBoxPreference android:key="gs_always_allow_stealing_from_knocked_out_actors" android:title="@string/gs_always_allow_stealing_from_knocked_out_actors_title" android:summary="@string/gs_always_allow_stealing_from_knocked_out_actors_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/l10n_gs_game_mechanics_movement_combat_title">
