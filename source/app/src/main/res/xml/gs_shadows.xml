<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="General">

        <CheckBoxPreference
            android:key="gs_enable_shadows"
            android:title="Enable Shadows"
            android:defaultValue="false"
            android:summary="Enable OpenMW real-time shadow mapping. This uses the shader rendering path and can reduce performance." />

    </PreferenceCategory>

    <PreferenceCategory android:title="Shadow Casters">

        <CheckBoxPreference
            android:key="gs_player_shadows"
            android:title="Player Shadows"
            android:defaultValue="true"
            android:dependency="gs_enable_shadows"
            android:summary="Allow the player character to cast shadows." />

        <CheckBoxPreference
            android:key="gs_actor_shadows"
            android:title="Actor Shadows"
            android:defaultValue="true"
            android:dependency="gs_enable_shadows"
            android:summary="Allow NPCs and creatures to cast shadows." />

        <CheckBoxPreference
            android:key="gs_object_shadows"
            android:title="Object Shadows"
            android:defaultValue="true"
            android:dependency="gs_enable_shadows"
            android:summary="Allow world objects to cast shadows." />

        <CheckBoxPreference
            android:key="gs_terrain_shadows"
            android:title="Terrain Shadows"
            android:defaultValue="true"
            android:dependency="gs_enable_shadows"
            android:summary="Allow terrain to cast shadows." />

        <CheckBoxPreference
            android:key="gs_indoor_shadows"
            android:title="Indoor Shadows"
            android:defaultValue="true"
            android:dependency="gs_enable_shadows"
            android:summary="Allow shadows indoors. Due to Morrowind data limitations, only actors can cast indoor shadows." />

    </PreferenceCategory>

    <PreferenceCategory android:title="Quality &amp; Distance">

        <ListPreference
            android:key="gs_shadow_quality"
            android:title="Shadow Quality"
            android:dialogTitle="Shadow Quality"
            android:entries="@array/gs_shadow_quality_entries"
            android:entryValues="@array/gs_shadow_quality_values"
            android:defaultValue="medium"
            android:dependency="gs_enable_shadows"
            android:summary="%s" />

        <ListPreference
            android:key="gs_shadow_distance"
            android:title="Shadow Distance"
            android:dialogTitle="Shadow Distance"
            android:entries="@array/gs_shadow_distance_entries"
            android:entryValues="@array/gs_shadow_distance_values"
            android:defaultValue="medium"
            android:dependency="gs_enable_shadows"
            android:summary="%s" />

    </PreferenceCategory>

</PreferenceScreen>
